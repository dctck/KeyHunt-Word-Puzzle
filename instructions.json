{
  "title": "How to Play",
  "steps": [
    "<div class=\"text-center\"><h2 class=\"text-xl font-bold mb-0\">Goal</h2></div>",
    "<p class=\"text-left mb-8\">Keep submitting valid words to collect key letters, and solve the puzzle by reaching the word that uses all key letters.</p>",
    
    "<div class=\"text-center\"><h2 class=\"text-xl font-bold mb-0 mt-8\">Rules</h2></div>",
    "<p class=\"mb-1\">a. You must change only <strong>One Letter</strong> from the previous word.</p>",
    "<p class=\"mb-8\">b. You can <strong>Rearrange Letters</strong> any order you want.</p>",
    
    "<div class=\"text-center\"><h2 class=\"text-xl font-bold mb-0 mt-8\">Examples</h2></div>",
    "<div class=\"space-y-2 py-2 mb-6\"><div class=\"flex flex-col items-center gap-1\"><div class=\"flex gap-1\"><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">F</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">A</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">T</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">E</div></div> <div class=\"flex gap-1 text-gray-500\">↓</div> <div class=\"flex gap-1\"><div class=\"w-10 h-10 flex items-center justify-center bg-green-600 rounded text-lg font-bold\">L</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">A</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">T</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">E</div></div></div><p class=\"text-xs text-center text-gray-400\">1 letter changed <br> <span class=\"text-green-500\">Acceptable</span></p></div>",
    "<div class=\"space-y-2 py-2 mb-6\"><div class=\"flex flex-col items-center gap-1\"><div class=\"flex gap-1\"><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">F</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">A</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">T</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">E</div></div> <div class=\"flex gap-1 text-gray-500\">↓</div> <div class=\"flex gap-1\"><div class=\"w-10 h-10 flex items-center justify-center bg-green-600 rounded text-lg font-bold\">B</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg border-2 border-green-600 font-bold\">E</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg border-2 border-green-600  font-bold\">A</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg border-2 border-green-600  font-bold\">T</div></div></div><p class=\"text-xs text-center text-gray-400\">1 letter changed, rearranged <br> <span class=\"text-green-500\">Acceptable</span></p></div>",
    "<div class=\"space-y-2 py-2 mb-6\"><div class=\"flex flex-col items-center gap-1\"><div class=\"flex gap-1\"><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">B</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">I</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">T</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">E</div></div> <div class=\"flex gap-1 text-gray-500\">↓</div> <div class=\"flex gap-1\"><div class=\"w-10 h-10 flex items-center justify-center bg-red-600 rounded text-lg font-bold\">S</div><div class=\"w-10 h-10 flex items-center justify-center bg-red-600 rounded text-lg font-bold\">H</div><div class=\"w-10 h-10 flex items-center justify-center bg-red-600 rounded text-lg font-bold\">O</div><div class=\"w-10 h-10 flex items-center justify-center bg-gray-700 rounded text-lg font-bold\">T</div></div></div><p class=\"text-xs text-center text-gray-400\">3 letters changed <br> <span class=\"text-red-600\">Not Acceptable</span> </p></div>",

    "<div class=\"text-center\"><h2 class=\"text-xl font-bold mb-0 mt-8\">Key Indicators</h2></div>",
    "<p class=\"text-left mb-4\">If a <strong>non-key</strong> letter was used, it shows <span class=\"text-cyan-400\">blue dots</span> indicating how many <span class=\"text-cyan-400\">key letters</span> it is touching on the keyboard.</p>",
    
    "<div class=\"mb-6\"><p class=\"text-sm font-semibold mb-3 text-center\">Range of Search</p><div class=\"flex justify-center gap-8 mb-4\"><div class=\"text-center\"><img src=\"miniKeyboardLayout/adjacentDKey_2x.webp\" alt=\"D key adjacency example\" class=\"max-w-full h-auto rounded mb-2 mx-auto\" style=\"width: 70%;\" /><p class=\"text-xs text-gray-400\"><strong>D</strong> is touching: <br> S, E, R, F, C, X</p></div><div class=\"text-center\"><img src=\"miniKeyboardLayout/adjacentLKey_2x.webp\" alt=\"L key adjacency example\" class=\"max-w-full h-auto rounded mb-2 mx-auto\" style=\"width: 70%;\" /><p class=\"text-xs text-gray-400\"><strong>L</strong> is touching: <br> K, O, P</p></div></div></div>",

    "<div class=\"mb-6\"><p class=\"text-sm font-semibold mb-3 text-center\">Indicator Example</p><div class=\"flex justify-center mb-4\"><img src=\"miniKeyboardLayout/keyboardExample_2x.webp\" alt=\"Keyboard layout showing target keys\" class=\"max-w-full h-auto rounded\" style=\"width: 70%;\" /></div><p class=\"text-xs text-center text-gray-400 mb-4\">Keys <span class=\"text-cyan-400\">D</span>, <span class=\"text-cyan-400\">G</span>, <span class=\"text-cyan-400\">C</span> are target letters</p></div>"
    
    
  ]
